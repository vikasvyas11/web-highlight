{
  "manifest_version": 3,
  "name": "Underlight",
  "description": "Highlight, underline, and leave notes on webpages. Revisit them in your private local library.",
  "version": "1.0.0",
  "minimum_chrome_version": "134",
  "options_page": "library.html",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Underlight library"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "anchors.js",
        "content.js"
      ],
      "css": [
        "marks.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
